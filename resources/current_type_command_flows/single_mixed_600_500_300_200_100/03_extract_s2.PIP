!========================================================================================================此文件用于提取焊缝载荷数据，分别提取：
 

/PREP7
NODENUM=3*senum   !螺栓节点的个数

*DO,I,1,senum,1
KXALS%3*(I-1)+1%=501+I*10       !每个关键点号
KXALS%3*(I-1)+2%=601+I*10
KXALS%3*(I-1)+3%=701+I*10
*ENDDO

*DO,J,1,senum1,1
KYALS%3*senum+3*(J-1)+1%=1501+J*10       !每个关键点号
KYALS%3*senum+3*(J-1)+2%=1601+J*10
KYALS%3*senum+3*(J-1)+3%=1701+J*10
*ENDDO

*DO,I,1,NODENUM,1
KSEL,S,,,KXALS%I%              !每个节点号
NSLK,S
*GET,NKXALS%I%,NODE,0,NUM,MAX
*ENDDO 

/POST1    
ALLSEL
!------------------第1步------
*DIM,XAFLS21,ARRAY,NODENUM,6,3
*DO,K,1,3,1
LCASE,38+K
	*DO,I,1,NODENUM,1
	NSEL,S,,,NKXALS%I%
	ESLN,S
	*GET,XAENUM%I%,ELEM,,NUM,MAX
	*GET,XAFLS21(I,1,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,FX
	*GET,XAFLS21(I,2,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,FY	
	*GET,XAFLS21(I,3,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,FZ	
	*GET,XAFLS21(I,4,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,MX	
	*GET,XAFLS21(I,5,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,MY	
	*GET,XAFLS21(I,6,K),ELEM,XAENUM%I%,EFOR,NKXALS%I%,MZ
	*ENDDO	
*ENDDO

*DIM,NUMXAFLS21,ARRAY,NODENUM   !节点号数组
*DO,I,1,NODENUM,1
NUMXAFLS21(I)=NKXALS%I%
*ENDDO

 


!------------------第2步
*DIM,XAFLS22,ARRAY,NODENUM,6,3                  !4个方形卡螺栓耦合点
*DO,K,1,3,1
	*DO,I,1,NODENUM,1
	XAFLS22(I,1,K)=ABS(XAFLS21(I,1,K))
	XAFLS22(I,2,K)=ABS(XAFLS21(I,2,K))
	XAFLS22(I,3,K)=ABS(XAFLS21(I,3,K))	
	XAFLS22(I,4,K)=ABS(XAFLS21(I,4,K))
	XAFLS22(I,5,K)=ABS(XAFLS21(I,5,K))
	XAFLS22(I,6,K)=ABS(XAFLS21(I,6,K))	
	*ENDDO	
*ENDDO  


 


!------------------第3步
*DIM,XAFLS23,ARRAY,3,6            !工况X力
*DO,I,1,3,1                       !行 工况
	*DO,J,1,6,1                     !列 力
	*VSCFUN,XAFLS23(I,J),MAX,XAFLS22(1,J,I)
	*ENDDO
*ENDDO

 



!------------------第4步
*DIM,XAFLS24,ARRAY,2,6              !
*DO,J,1,6,1
	XAFLS24(1,J)=XAFLS23(1,J)+XAFLS23(2,J)  !异常载荷=自重+SL-1
	XAFLS24(2,J)=XAFLS23(1,J)+XAFLS23(3,J)  !事故载荷=自重+SL-2
*ENDDO

 

     
!--------最终数据导出，数据与XAFLS24.txt一致，只是缺少工况及载荷描述
*CREATE,HF-FORCE-WRITE,MAC
*CFOPEN,HF-FORCE,LIS
*VWRITE,XAFLS24(1,1),XAFLS24(1,2),XAFLS24(1,3),XAFLS24(1,4),XAFLS24(1,5),XAFLS24(1,6)
(2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1)
*CFCLOS
*END
HF-FORCE-WRITE	

*ENDIF



!---------------------------------------------------------------------------------------===================================提取基础载荷
 

 
 
ALLSEL
NKMS01=NODE(KX(501+senum),KY(501+senum),KZ(501+senum))
NKMS02=NODE(KX(601+senum),KY(601+senum),KZ(601+senum))
NKMS03=NODE(KX(701+senum),KY(701+senum),KZ(701+senum))

!=============================定义一些工况数组，后面会引用
/POST1    
ALLSEL
*DIM,LSCASE1,CHAR,3
LSCASE1(1)='DW'
LSCASE1(2)='SL-1'
LSCASE1(3)='SL-2'

*DIM,LSCASE2,CHAR,2
LSCASE2(1)='UPSET'
LSCASE2(2)='FAULTED'



/POST1    
ALLSEL
!------------------第1步------
*DIM,FMS01,ARRAY,3,6,3
*DO,K,1,3,1
LCASE,38+K
	*DO,I,1,3,1
	ALLSEL
	NSEL,S,,,NKMS0%I%
	*GET,FMS01(I,1,K),NODE,NKMS0%I%,RF,FX
	*GET,FMS01(I,2,K),NODE,NKMS0%I%,RF,FY	
	*GET,FMS01(I,3,K),NODE,NKMS0%I%,RF,FZ	
	*GET,FMS01(I,4,K),NODE,NKMS0%I%,RF,MX	
	*GET,FMS01(I,5,K),NODE,NKMS0%I%,RF,MY	
	*GET,FMS01(I,6,K),NODE,NKMS0%I%,RF,MZ
	*ENDDO	
*ENDDO

*DIM,NUMFMS01,ARRAY,3
*DO,I,1,3,1
NUMFMS01(I)=NKMS0%I%
*ENDDO




!------------------第2步    
*DIM,FMS02,ARRAY,3,6,3                  !4个锚栓 
*DO,K,1,3,1
	*DO,I,1,3,1
	FMS02(I,1,K)=ABS(FMS01(I,1,K))
	FMS02(I,2,K)=ABS(FMS01(I,2,K))
	FMS02(I,3,K)=ABS(FMS01(I,3,K))
  FMS02(I,4,K)=ABS(FMS01(I,4,K))
	FMS02(I,5,K)=ABS(FMS01(I,5,K))
	FMS02(I,6,K)=ABS(FMS01(I,6,K))
		
	*ENDDO	
*ENDDO  


	
	
!------------------第3步
*DIM,FMS03,ARRAY,3,6              !工况X力
*DO,I,1,3,1                       !行 工况
	*DO,J,1,6,1                     !列 力
	*VSCFUN,FMS03(I,J),MAX,FMS02(1,J,I)
	*ENDDO
*ENDDO


!--------数据导出
*CREATE,JCZH-WRITE,MAC
*CFOPEN,JCZH,LIS
*VWRITE
(4X,'LSCASE'9X,'FX(m)',7X'FY(m)',7X'FZ(m)',7X'MX(Nm)',7X'MY(Nm)',7X'MZ(Nm)')
*VWRITE,LSCASE1(1),FMS03(1,1),FMS03(1,2),FMS03(1,3),FMS03(1,4),FMS03(1,5),FMS03(1,6)
(4X,A8,2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1,2X,F10.1)
*CFCLOS
*END
JCZH-WRITE




 
