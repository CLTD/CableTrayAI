*ELSE
!ESLEIF,I,LE,CASE,AND,I,GE,C+D+1
LCASE,A-1+I
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,        !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,        !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,     !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

ESORT,ETAB,SDIR
*GET,SSDIR(I)  ,SORT,,MAX
*GET,SNSDIR(I)  ,SORT,,MIN
ESORT,ETAB,SBEND1
*GET,SSBEND1(I),SORT,,MAX
*GET,SNSBEND1(I),SORT,,MIN
ESORT,ETAB,SBEND2
*GET,SSBEND2(I),SORT,,MAX
*GET,SNSBEND2(I),SORT,,MIN
ESORT,ETAB,SBEND3
*GET,SSBEND3(I),SORT,,MAX
*GET,SNSBEND3(I),SORT,,MIN
ESORT,ETAB,SBEND4
*GET,SSBEND4(I),SORT,,MAX
*GET,SNSBEND4(I),SORT,,MIN
ESORT,ETAB,SSHEAR
*GET,SSSHEAR(I),SORT,,MAX
*GET,SNSSHEAR(I),SORT,,MIN

*ENDIF
*ENDDO




!-----------------------------将结果数组再分配整理

*DIM,ASDIR1,,C
*DIM,ASDIR2,,C
*DIM,ASBEND,,C*8
*DIM,ASHEAR,,C*2

*DIM,BSDIR1,,D
*DIM,BSDIR2,,D
*DIM,BSBEND,,D*8
*DIM,BSHEAR,,D*2

*DIM,DSDIR1,,E
*DIM,DSDIR2,,E
*DIM,DSBEND,,E*8
*DIM,DSHEAR,,E*2

*DO,I,1,CASE,1
	*IF,I,LE,C,THEN
		ASDIR1(I)=SDIR(I)
		ASDIR2(I)=NSDIR(I)
		ASBEND(I)=SBEND1(I)
		ASBEND(C+I)=NSBEND1(I)
		ASBEND(2*C+I)=SBEND2(I)
		ASBEND(3*C+I)=NSBEND2(I)
		ASBEND(4*C+I)=SBEND3(I)
		ASBEND(5*C+I)=NSBEND3(I) 
		ASBEND(6*C+I)=SBEND4(I)
		ASBEND(7*C+I)=NSBEND4(I)
		ASHEAR(I)=SSHEAR(I)
		ASHEAR(C+I)=NSSHEAR(I)

	*ELSEIF,I,LE,C+D,AND,I,GE,C+1
		BSDIR1(I-C)=YSDIR(I)
		BSDIR2(I-C)=YNSDIR(I)
		BSBEND(I-C)=YSBEND1(I)			
		BSBEND(D+I-C)=YNSBEND1(I)
		BSBEND(2*D+I-C)=YSBEND2(I)			
		BSBEND(3*D+I-C)=YNSBEND2(I)
		BSBEND(4*D+I-C)=YSBEND3(I)			
		BSBEND(5*D+I-C)=YNSBEND3(I)
		BSBEND(6*D+I-C)=YSBEND4(I)			
		BSBEND(7*D+I-C)=YNSBEND4(I)		
		BSHEAR(I-C)=YSSHEAR(I)
		BSHEAR(D+I-C)=YNSSHEAR(I)

	*ELSE
		DSDIR1(I-C-D)=SSDIR(I)
		DSDIR2(I-C-D)=SNSDIR(I)
		DSBEND(I-C-D)=SSBEND1(I)			
		DSBEND(E+I-C-D)=SNSBEND1(I)
		DSBEND(2*E+I-C-D)=SSBEND2(I)			
		DSBEND(3*E+I-C-D)=SNSBEND2(I)
		DSBEND(4*E+I-C-D)=SSBEND3(I)			
		DSBEND(5*E+I-C-D)=SNSBEND3(I)
		DSBEND(6*E+I-C-D)=SSBEND4(I)			
		DSBEND(7*E+I-C-D)=SNSBEND4(I)		
		DSHEAR(I-C-D)=SSSHEAR(I)
		DSHEAR(E+I-C-D)=SNSSHEAR(I)
		
*ENDIF
*ENDDO


