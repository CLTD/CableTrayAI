!!本命令流为河北分公司核电工艺所力学室内部命令流工具，切勿外传；
!!本命令流可以批量导出梁单元正常、异常、事故工况下的拉伸、压缩、弯曲、剪切最大值及最大值云图；
!!云图名称：A/B/D分别代表准则级别，对应正常、异常、事故工况；
!!云图名称：SDIR1为拉伸应力，SDIR2为压缩应力，SBEND为弯曲应力，SHEAR为剪切应力；


!!使用步骤如下：
!!-1、选择需要导出结果的梁单元；
!!-2、定义起始工况数、最后工况数、正常工况数和异常工况数；
!!-3、把ANSYS图形界面大小调整到合适位置；
!!-4、运行下面命令流。
!!======================================!生成实体图
/UDOC,1,DATE,0 
/POST1 
LCZERO
LCASE,80,
LCWRITE,39,'ZIZHONG','',''        !!正常工况  自重


/REPLOT 
/ESHAPE,1
/RGB,INDEX,100,100,100, 0   
/RGB,INDEX, 80, 80, 80,13   
/RGB,INDEX, 60, 60, 60,14   
/RGB,INDEX, 0, 0, 0,15  
/REPLOT 

/VIEW,1,,-1 
/ANG,1  
/REP,FAST   
/AUTO,1 
/REP,FAST 
/ANG,1,30,YS,1  
/REP,FAST   
/ANG,1,30,XS,1  
/REP,FAST 
/AUTO,1
/REP,FAST 

/image,save,SHITI,bmp 

/ESHAPE,0
 
/REPLOT 


!!======================================定义参数
!!----------------!选择梁单元
/PREP7
ElasM=2.04E11     !定义弹性模量Elastic Modulus

!!----------------!选择梁单元
/PREP7
 
ESEL,S,TYPE,,1
 

!!----------------!定义参数
/POST1                         
A=80        !起始工况数-定义
B=84        !最后工况数-定义

C=1         !正常工况数-定义
D=2        !异常工况数-定义
E=B-A+1-C-D !事故工况数
CASE=C+D+E  !总的工况数!!======================================!调整角度
 


 

!!======================================!进入后处理
KEYW,PR_SGVOF,1      !关闭Verify确认弹窗
 
!-----------正常
*DIM,SDIR  ,,CASE
*DIM,SBEND1,,CASE
*DIM,SBEND2,,CASE
*DIM,SBEND3,,CASE
*DIM,SBEND4,,CASE
*DIM,SSHEAR,,CASE

*DIM,NSDIR  ,,CASE
*DIM,NSBEND1,,CASE
*DIM,NSBEND2,,CASE
*DIM,NSBEND3,,CASE
*DIM,NSBEND4,,CASE
*DIM,NSSHEAR,,CASE

!-----------异常
*DIM,YSDIR  ,,CASE
*DIM,YSBEND1,,CASE
*DIM,YSBEND2,,CASE
*DIM,YSBEND3,,CASE
*DIM,YSBEND4,,CASE
*DIM,YSSHEAR,,CASE

*DIM,YNSDIR  ,,CASE
*DIM,YNSBEND1,,CASE
*DIM,YNSBEND2,,CASE
*DIM,YNSBEND3,,CASE
*DIM,YNSBEND4,,CASE
*DIM,YNSSHEAR,,CASE

!-----------事故
*DIM,SSDIR  ,,CASE
*DIM,SSBEND1,,CASE
*DIM,SSBEND2,,CASE
*DIM,SSBEND3,,CASE
*DIM,SSBEND4,,CASE
*DIM,SSSHEAR,,CASE

*DIM,SNSDIR  ,,CASE
*DIM,SNSBEND1,,CASE
*DIM,SNSBEND2,,CASE
*DIM,SNSBEND3,,CASE
*DIM,SNSBEND4,,CASE
*DIM,SNSSHEAR,,CASE


*DO,I,1,CASE
*IF,I,LE,C,THEN
LCASE,A-1+I
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,      !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,        !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,   !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

ESORT,ETAB,SDIR
*GET,SDIR(I)  ,SORT,,MAX
*GET,NSDIR(I)  ,SORT,,MIN
ESORT,ETAB,SBEND1
*GET,SBEND1(I),SORT,,MAX
*GET,NSBEND1(I),SORT,,MIN
ESORT,ETAB,SBEND2
*GET,SBEND2(I),SORT,,MAX
*GET,NSBEND2(I),SORT,,MIN
ESORT,ETAB,SBEND3
*GET,SBEND3(I),SORT,,MAX
*GET,NSBEND3(I),SORT,,MIN
ESORT,ETAB,SBEND4
*GET,SBEND4(I),SORT,,MAX
*GET,NSBEND4(I),SORT,,MIN
ESORT,ETAB,SSHEAR
*GET,SSHEAR(I),SORT,,MAX
*GET,NSSHEAR(I),SORT,,MIN


*ELSEIF,I,LE,C+D,AND,I,GE,C+1
LCASE,A-1+I
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,        !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,        !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,     !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

ESORT,ETAB,SDIR
*GET,YSDIR(I)  ,SORT,,MAX
*GET,YNSDIR(I)  ,SORT,,MIN
ESORT,ETAB,SBEND1
*GET,YSBEND1(I),SORT,,MAX
*GET,YNSBEND1(I),SORT,,MIN
ESORT,ETAB,SBEND2
*GET,YSBEND2(I),SORT,,MAX
*GET,YNSBEND2(I),SORT,,MIN
ESORT,ETAB,SBEND3
*GET,YSBEND3(I),SORT,,MAX
*GET,YNSBEND3(I),SORT,,MIN
ESORT,ETAB,SBEND4
*GET,YSBEND4(I),SORT,,MAX
*GET,YNSBEND4(I),SORT,,MIN
ESORT,ETAB,SSHEAR
*GET,YSSHEAR(I),SORT,,MAX
*GET,YNSSHEAR(I),SORT,,MIN


*ELSE
!ESLEIF,I,LE,CASE,AND,I,GE,C+D+1
LCASE,A-1+I
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,        !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,        !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,     !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

ESORT,ETAB,SDIR
*GET,SSDIR(I)  ,SORT,,MAX
*GET,SNSDIR(I)  ,SORT,,MIN
ESORT,ETAB,SBEND1
*GET,SSBEND1(I),SORT,,MAX
*GET,SNSBEND1(I),SORT,,MIN
ESORT,ETAB,SBEND2
*GET,SSBEND2(I),SORT,,MAX
*GET,SNSBEND2(I),SORT,,MIN
ESORT,ETAB,SBEND3
*GET,SSBEND3(I),SORT,,MAX
*GET,SNSBEND3(I),SORT,,MIN
ESORT,ETAB,SBEND4
*GET,SSBEND4(I),SORT,,MAX
*GET,SNSBEND4(I),SORT,,MIN
ESORT,ETAB,SSHEAR
*GET,SSSHEAR(I),SORT,,MAX
*GET,SNSSHEAR(I),SORT,,MIN

*ENDIF
*ENDDO




!-----------------------------将结果数组再分配整理

*DIM,ASDIR1,,C
*DIM,ASDIR2,,C
*DIM,ASBEND,,C*8
*DIM,ASHEAR,,C*2

*DIM,BSDIR1,,D
*DIM,BSDIR2,,D
*DIM,BSBEND,,D*8
*DIM,BSHEAR,,D*2

*DIM,DSDIR1,,E
*DIM,DSDIR2,,E
*DIM,DSBEND,,E*8
*DIM,DSHEAR,,E*2

*DO,I,1,CASE,1
	*IF,I,LE,C,THEN
		ASDIR1(I)=SDIR(I)
		ASDIR2(I)=NSDIR(I)
		ASBEND(I)=SBEND1(I)
		ASBEND(C+I)=NSBEND1(I)
		ASBEND(2*C+I)=SBEND2(I)
		ASBEND(3*C+I)=NSBEND2(I)
		ASBEND(4*C+I)=SBEND3(I)
		ASBEND(5*C+I)=NSBEND3(I) 
		ASBEND(6*C+I)=SBEND4(I)
		ASBEND(7*C+I)=NSBEND4(I)
		ASHEAR(I)=SSHEAR(I)
		ASHEAR(C+I)=NSSHEAR(I)

	*ELSEIF,I,LE,C+D,AND,I,GE,C+1
		BSDIR1(I-C)=YSDIR(I)
		BSDIR2(I-C)=YNSDIR(I)
		BSBEND(I-C)=YSBEND1(I)			
		BSBEND(D+I-C)=YNSBEND1(I)
		BSBEND(2*D+I-C)=YSBEND2(I)			
		BSBEND(3*D+I-C)=YNSBEND2(I)
		BSBEND(4*D+I-C)=YSBEND3(I)			
		BSBEND(5*D+I-C)=YNSBEND3(I)
		BSBEND(6*D+I-C)=YSBEND4(I)			
		BSBEND(7*D+I-C)=YNSBEND4(I)		
		BSHEAR(I-C)=YSSHEAR(I)
		BSHEAR(D+I-C)=YNSSHEAR(I)

	*ELSE
		DSDIR1(I-C-D)=SSDIR(I)
		DSDIR2(I-C-D)=SNSDIR(I)
		DSBEND(I-C-D)=SSBEND1(I)			
		DSBEND(E+I-C-D)=SNSBEND1(I)
		DSBEND(2*E+I-C-D)=SSBEND2(I)			
		DSBEND(3*E+I-C-D)=SNSBEND2(I)
		DSBEND(4*E+I-C-D)=SSBEND3(I)			
		DSBEND(5*E+I-C-D)=SNSBEND3(I)
		DSBEND(6*E+I-C-D)=SSBEND4(I)			
		DSBEND(7*E+I-C-D)=SNSBEND4(I)		
		DSHEAR(I-C-D)=SSSHEAR(I)
		DSHEAR(E+I-C-D)=SNSSHEAR(I)
		
*ENDIF
*ENDDO


!-----------------------------
*DIM,MAXSDIR1,,3    !拉伸应力最大值
*DIM,MAXSDIR2,,3    !压缩应力最大值   
*DIM,MAXSBEND,,3    !弯曲应力最大值
*DIM,MAXSHEAR,,3    !剪切应力最大值

*DIM,MAXLSDIR1,,3    !拉伸应力最大值在数组的位置
*DIM,MAXLSDIR2,,3    !压缩应力最大值在数组的位置   
*DIM,MAXLSBEND,,3    !弯曲应力最大值在数组的位置
*DIM,MAXLSHEAR,,3    !剪切应力最大值在数组的位置

*DIM,MAXCSDIR1,,3    !拉伸应力最大值的工况
*DIM,MAXCSDIR2,,3    !压缩应力最大值的工况  
*DIM,MAXCSBEND,,3    !弯曲应力最大值的工况
*DIM,MAXCSHEAR,,3    !剪切应力最大值的工况


!-----------------------------最大值
*VSCFUN,MAXSDIR1(1),MAX,ASDIR1(1)    !正常工况最大值
*VSCFUN,MAXSDIR2(1),MIN,ASDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXSBEND(1),MAX,ASBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXSHEAR(1),MAX,ASHEAR(1)

*VSCFUN,MAXSDIR1(2),MAX,BSDIR1(1)    !异常工况最大值
*VSCFUN,MAXSDIR2(2),MIN,BSDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXSBEND(2),MAX,BSBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXSHEAR(2),MAX,BSHEAR(1)

*VSCFUN,MAXSDIR1(3),MAX,DSDIR1(1)    !事故工况最大值
*VSCFUN,MAXSDIR2(3),MIN,DSDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXSBEND(3),MAX,DSBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXSHEAR(3),MAX,DSHEAR(1)


!-----------------------------最大值在数组的位置
*VSCFUN,MAXLSDIR1(1),LMAX,ASDIR1(1)    !正常工况最大值在数组的位置
*VSCFUN,MAXLSDIR2(1),LMIN,ASDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSBEND(1),LMAX,ASBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSHEAR(1),LMAX,ASHEAR(1)

*VSCFUN,MAXLSDIR1(2),LMAX,BSDIR1(1)    !异常工况最大值在数组的位置
*VSCFUN,MAXLSDIR2(2),LMIN,BSDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSBEND(2),LMAX,BSBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSHEAR(2),LMAX,BSHEAR(1)

*VSCFUN,MAXLSDIR1(3),LMAX,DSDIR1(1)    !事故工况最大值在数组的位置
*VSCFUN,MAXLSDIR2(3),LMIN,DSDIR2(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSBEND(3),LMAX,DSBEND(1)
*VABS,1,1,1,1
*VSCFUN,MAXLSHEAR(3),LMAX,DSHEAR(1)


!=============================拉伸应力
!-----------------------------拉伸应力-正常工况
MAXCSDIR1(1)=MAXLSDIR1(1)+A-1
LCASE,MAXCSDIR1(1)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向拉伸
/image,save,A1SDIR1-%MAXCSDIR1(1)%,bmp    ! 

!-----------------------------拉伸应力-异常工况
MAXCSDIR1(2)=MAXLSDIR1(2)+A+C-1 
LCASE,MAXCSDIR1(2) 
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向拉伸
/image,save,B1SDIR1-%MAXCSDIR1(2)%,bmp    ! 

!-----------------------------拉伸应力-事故工况
MAXCSDIR1(3)=MAXLSDIR1(3)+A+C+D-1
LCASE,MAXCSDIR1(3)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向拉伸
/image,save,D1SDIR1-%MAXCSDIR1(3)%,bmp    ! 


!=============================压缩应力
!-----------------------------压缩应力-正常工况
MAXCSDIR2(1)=MAXLSDIR2(1)+A-1
LCASE,MAXCSDIR2(1)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向压缩
/image,save,A2SDIR2-%MAXCSDIR2(1)%,bmp    ! 

!-----------------------------压缩应力-异常工况
MAXCSDIR2(2)=MAXLSDIR2(2)+A+C-1 
LCASE,MAXCSDIR2(2)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向压缩
/image,save,B2SDIR2-%MAXCSDIR2(2)%,bmp    ! 

!-----------------------------压缩应力-事故工况
MAXCSDIR2(3)=MAXLSDIR2(3)+A+C+D-1
LCASE,MAXCSDIR2(3)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变

SADD,SBEND1,SBYT,SBZT
SADD,SBEND2,SBYB,SBZT
SADD,SBEND3,SBYB,SBZB
SADD,SBEND4,SBYT,SBZB

SMULT,SEY2,SEY,SEY,1,1,             !剪切应变平方 
SMULT,SEZ2,SEZ,SEZ,1,1,             !剪切应变平方
SADD,SEYZ2,SEY2,SEZ2,1,1,,          !剪切应变平方和
SEXP,SE,SEYZ2,,0.5,1                !剪切应变平方和再开方
SMULT,SSHEAR,SE, ,ElasM/2.6,1,      !按剪切胡克定律求剪应力

PLLS,SDIR,SDIR,1,0                  !轴向压缩
/image,save,D2SDIR2-%MAXCSDIR2(3)%,bmp    ! 


!=============================弯曲应力
!-----------------------------弯曲应力-正常工况
*IF,MAXLSBEND(1),LE,C,THEN
MAXCSBEND(1)=MAXLSBEND(1)+A-1
LCASE,MAXCSBEND(1)
ETABLE,SDIR,SMISC, 31
ETABLE,SBYT,SMISC, 32
ETABLE,SBYB,SMISC, 33
ETABLE,SBZT,SMISC, 34
ETABLE,SBZB,SMISC, 35
ETABLE,SEY,SMISC,12             !剪切应变
ETABLE,SEZ,SMISC,11             !剪切应变
